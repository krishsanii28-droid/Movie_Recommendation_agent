# ---------------------------------------------------------------------------
# MoodReel configuration. Copy to `.env` (repo root or backend/) and fill in.
# Everything is optional: with no keys the app runs on the curated seed
# catalogue and the built-in fallbacks (hashing embeddings, lexicon emotions,
# rule-based planner).
# ---------------------------------------------------------------------------

# --- TMDB (https://www.themoviedb.org/settings/api) — either one works
TMDB_API_KEY=
TMDB_READ_TOKEN=
TMDB_REQUESTS_PER_SECOND=20
REGION=IN

# --- Storage
# SQLite by default; for PostgreSQL: postgresql+psycopg://user:pass@host:5432/moodreel
DATABASE_URL=sqlite:///./data/moodreel.db
CHROMA_DIR=./data/chroma
VECTOR_BACKEND=auto            # auto | chroma | memory

# --- Models ("auto" = use Hugging Face if installed, else fall back)
EMBEDDING_BACKEND=auto         # auto | sentence-transformers | hashing
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMOTION_BACKEND=auto           # auto | hf | lexicon
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# LLM planner: none (rule-based) | hf_inference (needs HF_TOKEN) | local (runs on your machine)
LLM_BACKEND=none
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
LLM_MAX_NEW_TOKENS=512
HF_TOKEN=

# --- Agent
AGENT_MAX_STEPS=6
DEFAULT_RECOMMENDATIONS=4

# --- API
# JSON list of allowed browser origins (add your Vercel/Netlify URL in production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional regex, e.g. for Vercel preview deploys: https://moodreel-.*\.vercel\.app
CORS_ORIGIN_REGEX=
LOG_LEVEL=INFO
